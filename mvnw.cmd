@REM ----------------------------------------------------------------------------
@REM Apache Maven Wrapper startup batch script, version 3.3.4
@REM
@REM Optional ENV vars
@REM   MVNW_REPOURL - repo url base for downloading maven distribution
@REM   MVNW_USERNAME/MVNW_PASSWORD - user and password for downloading maven
@REM   MVNW_VERBOSE - true: enable verbose log; others: silence the output
@REM ----------------------------------------------------------------------------

@REM ============================================================================
@REM WHAT THIS FILE IS
@REM
@REM mvnw.cmd is the Maven Wrapper for Windows. Its job: let anyone build this
@REM project with the right Maven version WITHOUT installing Maven first.
@REM You run   mvnw.cmd clean package   exactly as you would run   mvn clean package.
@REM
@REM The first time, it downloads the Maven version named in
@REM .mvn/wrapper/maven-wrapper.properties - the distributionUrl line - unzips it
@REM into your user folder .m2/wrapper/dists, then runs it. Every later run finds
@REM that copy already there and starts it directly, with no download.
@REM Linux and macOS, and the Jenkins container, use the twin script mvnw.
@REM
@REM HOW THE FILE IS BUILT - ONE FILE, TWO LANGUAGES
@REM
@REM 1. Lines from the top to the line  : end batch / begin powershell  are a
@REM    Windows batch script, run by cmd.exe when you type mvnw.cmd.
@REM 2. Everything after that line is a PowerShell script.
@REM
@REM The trick that makes this work:
@REM - The very first line starts a PowerShell block comment. So when PowerShell
@REM   reads this file, it skips the whole batch part as one big comment, and
@REM   the end-batch line closes that comment.
@REM - cmd.exe treats the first line as harmless, and the batch part ends with
@REM   GOTO :EOF - go to end of file - so cmd.exe never reads the PowerShell part.
@REM
@REM THE FLOW
@REM
@REM a. cmd.exe runs the batch part below.
@REM b. The batch part starts PowerShell and hands it this same file.
@REM c. PowerShell finds or downloads Maven, then prints ONE line:
@REM        MVN_CMD=the full path of mvn.cmd
@REM d. The batch part reads that line, then runs that mvn.cmd with all the
@REM    arguments you typed, for example  clean package.
@REM
@REM WHY NOT DO EVERYTHING IN BATCH? Batch cannot download files, compute
@REM checksums or unzip archives. PowerShell, built into Windows, can.
@REM
@REM EDITING RULE FOR THIS FILE
@REM The file is generated by the Maven Wrapper plugin. Running
@REM   mvnw.cmd wrapper:wrapper
@REM rewrites it and these explanatory comments are lost.
@REM ============================================================================

@REM ---- BATCH PART ------------------------------------------------------------
@REM The @ at the start of each line stops cmd.exe from echoing the command
@REM itself on screen. SET NAME=value stores a variable. SET NAME= with nothing
@REM after the equals sign deletes the variable.

@REM Remember the name this script was started with - normally mvnw.cmd - unless
@REM a caller already set it. PowerShell uses it later to derive mvn.cmd.
@IF "%__MVNW_ARG0_NAME__%"=="" (SET __MVNW_ARG0_NAME__=%~nx0)

@REM Clear two working variables, in case an earlier run left them behind:
@REM __MVNW_CMD__ will receive the path of mvn.cmd found by PowerShell.
@SET __MVNW_CMD__=
@SET __MVNW_ERROR__=

@REM PSModulePath tells PowerShell where to load modules from. Another tool may
@REM have changed it. Save the current value, then empty it, so PowerShell starts
@REM with its own default modules. The saved value is put back after PowerShell.
@SET __MVNW_PSMODULEP_SAVE=%PSModulePath%
@SET PSModulePath=

@REM THE KEY LINE. In plain words:
@REM - Start PowerShell, without the user profile - noprofile - so a personal
@REM   PowerShell setup cannot interfere.
@REM - Give PowerShell two values: scriptDir = the folder of this file, and
@REM   script = the name this file was started with.
@REM - Read THIS file as text - Get-Content - and run it as PowerShell code.
@REM   The batch part is a comment for PowerShell, so only the PowerShell part
@REM   at the bottom of this file actually runs.
@REM - FOR /F reads every line PowerShell prints and splits it at the first
@REM   equals sign: the text before goes into A, the text after into B.
@REM - If A is MVN_CMD, remember B, the path of mvn.cmd, in __MVNW_CMD__.
@REM   Any other line, for example an error message, is printed back on screen.
@FOR /F "usebackq tokens=1* delims==" %%A IN (`powershell -noprofile "& {$scriptDir='%~dp0'; $script='%__MVNW_ARG0_NAME__%'; icm -ScriptBlock ([Scriptblock]::Create((Get-Content -Raw '%~f0'))) -NoNewScope}"`) DO @(
  IF "%%A"=="MVN_CMD" (set __MVNW_CMD__=%%B) ELSE IF "%%B"=="" (echo %%A) ELSE (echo %%A=%%B)
)

@REM Put back the original PSModulePath and delete the helper variables.
@REM MVNW_USERNAME and MVNW_PASSWORD are optional download credentials: they are
@REM deleted so they are not passed on to Maven and the build.
@SET PSModulePath=%__MVNW_PSMODULEP_SAVE%
@SET __MVNW_PSMODULEP_SAVE=
@SET __MVNW_ARG0_NAME__=
@SET MVNW_USERNAME=
@SET MVNW_PASSWORD=

@REM If PowerShell returned a path, run the real Maven with all your arguments.
@REM The star-percent symbol in the line below means: all arguments typed after
@REM mvnw.cmd. Maven exit code becomes this script exit code, which is how
@REM Jenkins or your terminal know whether the build passed or failed.
@IF NOT "%__MVNW_CMD__%"=="" ("%__MVNW_CMD__%" %*)

@REM Reached only when PowerShell returned no path: print an error on the error
@REM stream and stop with exit code 1, meaning failure.
@echo Cannot start maven from wrapper >&2 && exit /b 1

@REM Jump to the end of the file, so cmd.exe never tries to read the PowerShell
@REM code below as batch commands.
@GOTO :EOF
: end batch / begin powershell #>

# ---- POWERSHELL PART ---------------------------------------------------------
# Runs only when started by the batch part above. Two values arrive from it:
#   $scriptDir = folder containing this file, ending with a backslash
#   $script    = name this file was started with, normally mvnw.cmd
# Its only job: make sure the right Maven exists on this PC, then print
#   MVN_CMD=<full path of mvn.cmd>
# Anything else printed here is shown to the user by the batch part.

# Stop at the first error, instead of continuing in a broken state.
$ErrorActionPreference = "Stop"
# Set the environment variable MVNW_VERBOSE=true to see what the script does:
# every Write-Verbose message below is then printed.
if ($env:MVNW_VERBOSE -eq "true") {
  $VerbosePreference = "Continue"
}

# ---- Step 1: which Maven to use --------------------------------------------
# Read .mvn/wrapper/maven-wrapper.properties - simple key=value lines - and
# take the distributionUrl value: the download address of the Maven zip.
# In this project it points at Maven 3.9.16 on Maven Central.
# calculate distributionUrl, requires .mvn/wrapper/maven-wrapper.properties
$distributionUrl = (Get-Content -Raw "$scriptDir/.mvn/wrapper/maven-wrapper.properties" | ConvertFrom-StringData).distributionUrl
if (!$distributionUrl) {
  Write-Error "cannot read distributionUrl property in $scriptDir/.mvn/wrapper/maven-wrapper.properties"
}

# Two kinds of distribution are supported, recognised by the file name at the
# end of the URL:
# - maven-mvnd-*  : mvnd, the Maven Daemon, a faster Maven that stays running
#                   in the background. Its Windows zip has a different name,
#                   and its command is mvnd.cmd.
# - anything else : normal Apache Maven - the case of this project. The command
#                   is derived from this file name: mvnw.cmd becomes mvn.cmd.
switch -wildcard -casesensitive ( $($distributionUrl -replace '^.*/','') ) {
  "maven-mvnd-*" {
    $USE_MVND = $true
    $distributionUrl = $distributionUrl -replace '-bin\.[^.]*$',"-windows-amd64.zip"
    $MVN_CMD = "mvnd.cmd"
    break
  }
  default {
    $USE_MVND = $false
    $MVN_CMD = $script -replace '^mvnw','mvn'
    break
  }
}

# ---- Step 2: where Maven lives on this PC ------------------------------------
# MVNW_REPOURL (optional environment variable) replaces the download server,
# for example a company mirror such as Nexus or Artifactory. Only the server
# part of the URL changes; the path to the Maven zip stays the same.
# apply MVNW_REPOURL and calculate MAVEN_HOME
# maven home pattern: ~/.m2/wrapper/dists/{apache-maven-<version>,maven-mvnd-<version>-<platform>}/<hash>
if ($env:MVNW_REPOURL) {
  $MVNW_REPO_PATTERN = if ($USE_MVND -eq $False) { "/org/apache/maven/" } else { "/maven/mvnd/" }
  $distributionUrl = "$env:MVNW_REPOURL$MVNW_REPO_PATTERN$($distributionUrl -replace "^.*$MVNW_REPO_PATTERN",'')"
}
# File name of the zip, e.g. apache-maven-3.9.16-bin.zip ...
$distributionUrlName = $distributionUrl -replace '^.*/',''
# ... and the same name without .zip and without -bin: apache-maven-3.9.16
$distributionUrlNameMain = $distributionUrlName -replace '\.[^.]*$','' -replace '-bin$',''

# Base folder for Maven files: your user folder + .m2, e.g. C:\Users\ACER\.m2
# (the same folder that holds the downloaded libraries, .m2\repository).
# The environment variable MAVEN_USER_HOME can move it somewhere else.
$MAVEN_M2_PATH = "$HOME/.m2"
if ($env:MAVEN_USER_HOME) {
  $MAVEN_M2_PATH = "$env:MAVEN_USER_HOME"
}

# Create that folder if it does not exist yet (first use of Maven on this PC).
if (-not (Test-Path -Path $MAVEN_M2_PATH)) {
    New-Item -Path $MAVEN_M2_PATH -ItemType Directory | Out-Null
}

# Folder where the wrapper keeps downloaded Maven versions: .m2/wrapper/dists.
# If .m2 is a link to another folder (Target is set), use the real target
# folder instead, so the path is always a real one.
$MAVEN_WRAPPER_DISTS = $null
if ((Get-Item $MAVEN_M2_PATH).Target[0] -eq $null) {
  $MAVEN_WRAPPER_DISTS = "$MAVEN_M2_PATH/wrapper/dists"
} else {
  $MAVEN_WRAPPER_DISTS = (Get-Item $MAVEN_M2_PATH).Target[0] + "/wrapper/dists"
}

# Final install folder of this Maven version:
#   .m2/wrapper/dists/apache-maven-3.9.16/<hash>
# <hash> is the SHA-256 fingerprint of the download URL, written as 64 hex
# characters. Same URL = same folder, so the zip is downloaded only once. A
# different URL - another version or another mirror - gets its own folder.
$MAVEN_HOME_PARENT = "$MAVEN_WRAPPER_DISTS/$distributionUrlNameMain"
$MAVEN_HOME_NAME = ([System.Security.Cryptography.SHA256]::Create().ComputeHash([byte[]][char[]]$distributionUrl) | ForEach-Object {$_.ToString("x2")}) -join ''
$MAVEN_HOME = "$MAVEN_HOME_PARENT/$MAVEN_HOME_NAME"

# ---- Step 3: already installed? Then finish here ---------------------------
# The normal case after the first run: Maven is already in its folder. Print
# the MVN_CMD line for the batch part and exit; nothing is downloaded.
if (Test-Path -Path "$MAVEN_HOME" -PathType Container) {
  Write-Verbose "found existing MAVEN_HOME at $MAVEN_HOME"
  Write-Output "MVN_CMD=$MAVEN_HOME/bin/$MVN_CMD"
  exit $?
}

# ---- Step 4: first run - download and install Maven ------------------------
# Safety check: the URL must end with a file name such as *-bin.zip,
# otherwise it is not a Maven distribution the wrapper can install.
if (! $distributionUrlNameMain -or ($distributionUrlName -eq $distributionUrlNameMain)) {
  Write-Error "distributionUrl is not valid, must end with *-bin.zip, but found $distributionUrl"
}

# Create a private temporary folder for the download. Trick: ask Windows for a
# unique temporary file name, create a folder named <that name>.dir, then
# delete the temporary file and keep only the folder.
# prepare tmp dir
$TMP_DOWNLOAD_DIR_HOLDER = New-TemporaryFile
$TMP_DOWNLOAD_DIR = New-Item -Itemtype Directory -Path "$TMP_DOWNLOAD_DIR_HOLDER.dir"
$TMP_DOWNLOAD_DIR_HOLDER.Delete() | Out-Null
# trap = "if any error happens from here on": delete the temporary folder, so
# a failed download does not leave half-written files behind.
trap {
  if ($TMP_DOWNLOAD_DIR.Exists) {
    try { Remove-Item $TMP_DOWNLOAD_DIR -Recurse -Force | Out-Null }
    catch { Write-Warning "Cannot remove $TMP_DOWNLOAD_DIR" }
  }
}

# Create the parent install folder, e.g. .m2/wrapper/dists/apache-maven-3.9.16
New-Item -Itemtype Directory -Path "$MAVEN_HOME_PARENT" -Force | Out-Null

# Download and Install Apache Maven
Write-Verbose "Couldn't find MAVEN_HOME, downloading and installing it ..."
Write-Verbose "Downloading from: $distributionUrl"
Write-Verbose "Downloading to: $TMP_DOWNLOAD_DIR/$distributionUrlName"

# Download the zip with the .NET web client built into Windows.
# If MVNW_USERNAME and MVNW_PASSWORD are set (a private server that needs a
# login), send them. Not needed for Maven Central.
# TLS 1.2 is forced because old Windows versions default to older, insecure
# protocols that Maven Central refuses.
$webclient = New-Object System.Net.WebClient
if ($env:MVNW_USERNAME -and $env:MVNW_PASSWORD) {
  $webclient.Credentials = New-Object System.Net.NetworkCredential($env:MVNW_USERNAME, $env:MVNW_PASSWORD)
}
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$webclient.DownloadFile($distributionUrl, "$TMP_DOWNLOAD_DIR/$distributionUrlName") | Out-Null

# Optional integrity check. If maven-wrapper.properties contains a
# distributionSha256Sum line, compute the SHA-256 fingerprint of the
# downloaded zip and compare: a mismatch means a corrupted or tampered file,
# and the script stops. This project does not set it, so the check is skipped.
# (mvnd downloads do not support this check.)
# If specified, validate the SHA-256 sum of the Maven distribution zip file
$distributionSha256Sum = (Get-Content -Raw "$scriptDir/.mvn/wrapper/maven-wrapper.properties" | ConvertFrom-StringData).distributionSha256Sum
if ($distributionSha256Sum) {
  if ($USE_MVND) {
    Write-Error "Checksum validation is not supported for maven-mvnd. `nPlease disable validation by removing 'distributionSha256Sum' from your maven-wrapper.properties."
  }
  Import-Module $PSHOME\Modules\Microsoft.PowerShell.Utility -Function Get-FileHash
  if ((Get-FileHash "$TMP_DOWNLOAD_DIR/$distributionUrlName" -Algorithm SHA256).Hash.ToLower() -ne $distributionSha256Sum) {
    Write-Error "Error: Failed to validate Maven distribution SHA-256, your Maven distribution might be compromised. If you updated your Maven version, you need to update the specified distributionSha256Sum property."
  }
}

# Unzip the download inside the temporary folder.
# unzip and move
Expand-Archive "$TMP_DOWNLOAD_DIR/$distributionUrlName" -DestinationPath "$TMP_DOWNLOAD_DIR" | Out-Null

# Find the folder the zip created. Normally it is named like the zip without
# -bin (apache-maven-3.9.16). Development builds (snapshots) can use another
# name, so if needed, look for any folder that contains bin/mvn.cmd.
# Find the actual extracted directory name (handles snapshots where filename != directory name)
$actualDistributionDir = ""

# First try the expected directory name (for regular distributions)
$expectedPath = Join-Path "$TMP_DOWNLOAD_DIR" "$distributionUrlNameMain"
$expectedMvnPath = Join-Path "$expectedPath" "bin/$MVN_CMD"
if ((Test-Path -Path $expectedPath -PathType Container) -and (Test-Path -Path $expectedMvnPath -PathType Leaf)) {
  $actualDistributionDir = $distributionUrlNameMain
}

# If not found, search for any directory with the Maven executable (for snapshots)
if (!$actualDistributionDir) {
  Get-ChildItem -Path "$TMP_DOWNLOAD_DIR" -Directory | ForEach-Object {
    $testPath = Join-Path $_.FullName "bin/$MVN_CMD"
    if (Test-Path -Path $testPath -PathType Leaf) {
      $actualDistributionDir = $_.Name
    }
  }
}

if (!$actualDistributionDir) {
  Write-Error "Could not find Maven distribution directory in extracted archive"
}

# Install: rename the unzipped folder to the <hash> name computed in step 2,
# then move it into .m2/wrapper/dists/apache-maven-3.9.16/.
# Rename-then-move makes the install appear in one step, so a half-copied
# Maven is never found by the next run.
# If the move fails, another build may have installed the same version at the
# same moment (two runs in parallel). That is fine as long as the final folder
# now exists; only if it is still missing is it an error.
# In all cases the temporary folder is deleted at the end (finally block).
Write-Verbose "Found extracted Maven distribution directory: $actualDistributionDir"
Rename-Item -Path "$TMP_DOWNLOAD_DIR/$actualDistributionDir" -NewName $MAVEN_HOME_NAME | Out-Null
try {
  Move-Item -Path "$TMP_DOWNLOAD_DIR/$MAVEN_HOME_NAME" -Destination $MAVEN_HOME_PARENT | Out-Null
} catch {
  if (! (Test-Path -Path "$MAVEN_HOME" -PathType Container)) {
    Write-Error "fail to move MAVEN_HOME"
  }
} finally {
  try { Remove-Item $TMP_DOWNLOAD_DIR -Recurse -Force | Out-Null }
  catch { Write-Warning "Cannot remove $TMP_DOWNLOAD_DIR" }
}

# Hand the result to the batch part: the path of the freshly installed mvn.cmd.
Write-Output "MVN_CMD=$MAVEN_HOME/bin/$MVN_CMD"
